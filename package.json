{
  "name": "coparent-app",
  "version": "1.0.0",
  "description": "co-parenting app",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "seed": "node --import tsx scripts/seed.ts",
    "test": "node --import tsx scripts/database-checks.ts && node --import tsx scripts/integration.ts",
    "test:dev": "node --import tsx scripts/integration.ts --dev",
    "typecheck": "tsc --noEmit",
    "test:db": "node --import tsx scripts/database-checks.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bryan060807/coparent-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/bryan060807/coparent-app/issues"
  },
  "homepage": "https://github.com/bryan060807/coparent-app#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
