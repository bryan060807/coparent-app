# Local development remains SQLite unless you opt in to Supabase.
APP_BACKEND=sqlite

# Hosted Vercel deployment: set APP_BACKEND=supabase and fill these in Vercel's
# Environment Variables panel. Never commit an actual .env.local file.
APP_ORIGIN=https://teambill.aibrylabs.com
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional exact extra origins, comma-separated. No wildcards.
# APP_ALLOWED_ORIGINS=https://your-project.vercel.app
